---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} publishedDate={post.data.date}>
  <article>
    <header class="mb-10">
      <h1 class="mb-3 text-2xl font-bold text-ink">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'long')}</time>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => <Badge variant="tag">#{tag}</Badge>)}
          </div>
        )}
      </div>
    </header>
    <div class="prose max-w-none">
      <Content />
    </div>
    <footer class="mt-12 border-t border-line pt-6">
      <a href="/blog" class="text-sm">← Back to all posts</a>
    </footer>
  </article>
</Base>
