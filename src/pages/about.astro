---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/prof_pic.jpg';
import { EMAIL, SITE_TITLE, SOCIAL_LINKS } from '../consts';

// The CV link appears once public/assets/cv.pdf is added.
const hasCv = existsSync(join(process.cwd(), 'public/assets/cv.pdf'));

const skills = [
  { label: 'Languages', items: 'Python, JavaScript, SQL, Bash' },
  { label: 'Systems & Data', items: 'Apache Spark, BigQuery, PostgreSQL' },
  { label: 'Web & Measurement', items: 'Web crawling, Selenium, HTTP Archive' },
  { label: 'Domains', items: 'Privacy engineering, AI governance, security' },
];
---

<Base title="About" description="PhD candidate at Northeastern University working on web privacy, measurement, and AI agents.">
  <div class="mb-10 flex items-start gap-6">
    <Image
      src={portrait}
      alt="Portrait of Abubakar Aziz"
      width={96}
      height={96}
      densities={[1, 2]}
      loading="eager"
      class="size-24 shrink-0 rounded-full object-cover"
    />
    <div>
      <h1 class="mb-1 text-2xl font-bold text-ink">{SITE_TITLE}</h1>
      <p class="text-sm text-muted">PhD Candidate · Northeastern University · Boston, MA</p>
      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        {SOCIAL_LINKS.map(({ href, label }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent hover:no-underline">{label}</a>
        ))}
      </div>
    </div>
  </div>

  <section class="mb-10 space-y-4 leading-relaxed">
    <p>
      I'm a final-year PhD candidate at Northeastern University. Previously, I also worked as a Privacy Engineer at National Internet Observatory.
    </p>
    <p>
      My research focuses on building tools to understand security and privacy issues on the web. Lately, I've also been building AI agents that can perform general tasks, and exploring the implications of agent skills.
    </p>
    <p>
      More than anything, I love building things from the ground up. Whether designing data pipelines, creating new tools, or exploring emerging technologies — I enjoy turning ideas into real, impactful systems. I'm actively seeking full-time roles in software engineering, privacy engineering, and systems engineering.
    </p>
  </section>

  <section class="mb-10">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="font-semibold text-ink">Experience & Education</h2>
      {hasCv && <a href="/assets/cv.pdf" target="_blank" rel="noopener" class="text-sm">Download CV ↓</a>}
    </div>

    <div class="space-y-6">
      <div>
        <div class="mb-1 flex flex-wrap items-baseline justify-between gap-x-4">
          <h3 class="font-medium text-ink">PhD, Computer Science</h3>
          <span class="text-sm text-muted">2020 – Present</span>
        </div>
        <p class="text-sm text-muted">Northeastern University · Boston, MA</p>
        <p class="mt-1 text-sm text-muted">Advisor: Christo Wilson · Focus: Web privacy, consent signals, CCPA compliance</p>
      </div>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="mb-4 font-semibold text-ink">Skills</h2>
    <dl class="grid gap-4 text-sm sm:grid-cols-2">
      {skills.map(({ label, items }) => (
        <div>
          <dt class="mb-2 font-medium text-muted">{label}</dt>
          <dd>{items}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="rounded-lg border border-line bg-teal-50/50 p-5 dark:bg-teal-900/10">
    <div class="mb-2 flex items-center gap-2">
      <span class="inline-block size-2 rounded-full bg-accent motion-safe:animate-pulse" aria-hidden="true"></span>
      <h2 class="font-semibold text-accent">Open to Work</h2>
    </div>
    <p class="mb-3 text-sm text-muted">
      I'm actively seeking full-time roles starting mid-2026. Interested in privacy engineering, software engineering, systems engineering, and research engineering positions.
    </p>
    <a href={`mailto:${EMAIL}`} class="text-sm">Get in touch →</a>
  </section>
</Base>
