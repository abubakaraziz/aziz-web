---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { getCollection } from 'astro:content';
import { AUTHOR_NAME } from '../consts';

const publications = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year);
---

<Base title="Publications" description="Papers and talks on web privacy, consent, and measurement.">
  <h1 class="mb-2 text-2xl font-bold text-ink">Publications</h1>
  <p class="mb-10 text-sm text-muted">* indicates equal contribution</p>

  <div class="space-y-8">
    {publications.map((pub) => (
      <article class="border-l-2 border-line pl-5 transition-colors hover:border-accent">
        {(pub.data.award || pub.data.status) && (
          <div class="mb-1 flex flex-wrap items-center gap-2">
            {pub.data.award && <Badge variant="award">★ {pub.data.award}</Badge>}
            {pub.data.status && <Badge variant="status"><i>{pub.data.status}</i></Badge>}
          </div>
        )}

        <h2 class="mb-1 font-semibold leading-snug text-ink">
          {pub.data.paper_title ?? pub.data.title}
        </h2>

        {pub.data.authors && (
          <p class="mb-1 text-sm text-muted">
            {pub.data.authors.split(AUTHOR_NAME).map((part, i) => (
              <>{i > 0 && <span class="font-medium text-ink">{AUTHOR_NAME}</span>}{part}</>
            ))}
          </p>
        )}

        <p class="mb-3 text-sm text-muted">
          {pub.data.venue && <><i class="text-accent">{pub.data.venue}</i>, </>}
          {pub.data.year}
        </p>

        <div class="flex gap-4 text-sm">
          {pub.data.paper && <a href={pub.data.paper}>[PDF]</a>}
          {pub.data.code && <a href={pub.data.code} target="_blank" rel="noopener noreferrer">[Code]</a>}
          {pub.data.html && <a href={pub.data.html} target="_blank" rel="noopener noreferrer">[HTML]</a>}
        </div>
      </article>
    ))}
  </div>
</Base>
