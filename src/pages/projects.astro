---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.hide_from_projects)
  .sort((a, b) => b.data.year - a.data.year);
---

<Base title="Projects" description="Research systems I've built, published at top venues in privacy and web measurement.">
  <h1 class="mb-2 text-2xl font-bold text-ink">Projects</h1>
  <p class="mb-10 text-muted">Research systems I've built — published at top venues in privacy and web measurement.</p>

  <div class="grid gap-5">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Base>
