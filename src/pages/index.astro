---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { EMAIL, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { formatDate } from '../utils/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Projects featured on the homepage, in display order.
const FEATURED_PROJECTS = ['google-topics-api', 'iab-ccpa', 'web-almanac-third-parties', 'google-search-market'];
const allProjects = await getCollection('projects');
const projects = FEATURED_PROJECTS.map((id) => {
  const project = allProjects.find((p) => p.id === id);
  if (!project) throw new Error(`Featured project "${id}" not found in src/content/projects`);
  return project;
});

const heroLinks = SOCIAL_LINKS.filter(({ label }) => label !== 'X');

const news = [
  { date: "Mar 2026", text: 'Industry talk accepted at PEPR 2026 — <a href="https://www.usenix.org/conference/pepr26/presentation/aziz">Why Consent Fails in Practice</a>' },
  { date: "Jan 2026", text: 'Paper on Google\'s Topics API accepted at <a href="https://www2026.thewebconf.org/">WWW 2026</a>' },
  { date: "Jan 2026", text: 'Co-authored the <a href="https://almanac.httparchive.org/en/2025/third-parties">Third Parties chapter</a> of the 2025 Web Almanac' },
  { date: "Jun 2025", text: "Presented Topics API poster at Google Ads Privacy Conference, Mountain View" },
  { date: "Nov 2024", text: 'Received travel grant; attended <a href="https://conferences.sigcomm.org/imc/2024/">IMC 2024</a> in Madrid' },
  { date: "Jul 2024", text: 'Presented PETS 2024 paper in Bristol, UK' },
  { date: "Jun 2024", text: 'Best Paper Honourable Mention at <a href="https://www.icwsm.org/2024/">AAAI ICWSM 2024</a>' },
];
---

<Base title={SITE_TITLE}>
  <!-- Hero -->
  <section class="mb-14">
    <div class="mb-5 flex items-start gap-6">
      <img
        src="/assets/prof_pic.jpg"
        alt="Portrait of Abubakar Aziz"
        width="112"
        height="112"
        class="size-28 shrink-0 rounded-full object-cover"
      />
      <div>
        <h1 class="mb-1 text-2xl font-bold text-ink">{SITE_TITLE}</h1>
        <p class="mb-3 text-xs text-muted">Research Engineer · PhD Candidate · Northeastern University · Boston, MA</p>
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <span class="flex items-center gap-1.5 font-medium text-accent">
            <span class="inline-block size-2 rounded-full bg-accent motion-safe:animate-pulse" aria-hidden="true"></span>
            Open to work
          </span>
          <a href={`mailto:${EMAIL}`} class="text-muted hover:text-accent hover:no-underline">Email</a>
          {heroLinks.map(({ href, label }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent hover:no-underline">{label}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="space-y-3 leading-relaxed">
      <p>I'm a final-year PhD candidate at Northeastern University.</p>
      <p>My research focuses on building tools to understand security and privacy issues on the web. Lately, I've also been building AI agents that can perform general tasks, and exploring the implications of agent skills. I write about what I find, and I'm actively looking for full-time roles and postdoc positions in industry or academia.</p>
    </div>
  </section>

  {/* Shown once there are 3+ blog posts */}
  {posts.length >= 3 && (
    <section class="mb-14">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="font-semibold text-ink">Recent Writing</h2>
        <a href="/blog" class="text-sm">View all →</a>
      </div>
      <ul class="space-y-4">
        {posts.map((post) => (
          <li class="flex items-baseline justify-between gap-4">
            <a href={`/blog/${post.id}/`} class="font-medium text-ink hover:text-accent hover:no-underline">
              {post.data.title}
            </a>
            <time datetime={post.data.date.toISOString()} class="shrink-0 text-sm text-muted">
              {formatDate(post.data.date)}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mb-14">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="font-semibold text-ink">Projects</h2>
      <a href="/projects" class="text-sm">View all →</a>
    </div>
    <div class="grid gap-4">
      {projects.map((project) => <ProjectCard project={project} compact />)}
    </div>
  </section>

  <section>
    <h2 class="mb-5 font-semibold text-ink">News</h2>
    <ul class="space-y-3">
      {news.map((item) => (
        <li class="flex gap-4 text-sm">
          <span class="w-20 shrink-0 text-muted">{item.date}</span>
          <span set:html={item.text} />
        </li>
      ))}
    </ul>
  </section>
</Base>
