---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Tighter layout used on the homepage. */
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { title, description, award, venue, status, tech, paper, code, html } = project.data;
const Heading = compact ? 'h3' : 'h2';
const shownTech = compact ? tech.slice(0, 3) : tech;
---

<article
  class:list={[
    'rounded-lg border border-line transition-colors hover:border-accent',
    compact ? 'p-4' : 'p-5',
  ]}
>
  <div class:list={['flex flex-wrap items-start justify-between gap-2', compact ? 'mb-1' : 'mb-2']}>
    <Heading class:list={['text-ink', compact ? 'text-sm font-medium' : 'font-semibold']}>{title}</Heading>
    <div class="flex flex-wrap items-center gap-2">
      {award && <Badge variant="award">★ {award}</Badge>}
      {venue && <Badge variant="venue">{venue}</Badge>}
      {status && <Badge variant="status">{status}</Badge>}
    </div>
  </div>
  <p class:list={['text-sm text-muted', compact ? 'mb-3' : 'mb-4']}>{description}</p>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
      {shownTech.map((t) => <li class="rounded bg-surface px-2 py-0.5 text-xs text-muted">{t}</li>)}
    </ul>
    <div class:list={['flex gap-3', compact ? 'text-xs' : 'text-sm']}>
      {paper && <a href={paper}>Paper</a>}
      {code && <a href={code} target="_blank" rel="noopener noreferrer">Code</a>}
      {html && <a href={html} target="_blank" rel="noopener noreferrer">Read</a>}
    </div>
  </div>
</article>
